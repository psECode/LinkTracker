# Шаблон окружения для docker compose.

# ─── Telegram-бот ────────────────────────────────────────────────────────────
# Обязателен для бота. Получить у @BotFather (/newbot).
TELEGRAM_TOKEN=

# Общий ключ для внутреннего трафика bot <-> scrapper (заголовок X-Internal-Token).
# Сгенерировать: openssl rand -hex 32
INTERNAL_API_TOKEN=

# Секрет для подписи/валидации JWT (HS256), минимум 32 байта.
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=

# Опциональны (без них API работают на публичных лимитах):
# GitHub: Settings -> Developer settings -> Personal access tokens (classic, без scopes)
GITHUB_TOKEN=
# StackOverflow: stackapps.com -> register app -> key
STACKOVERFLOW_KEY=
STACKOVERFLOW_ACCESS_KEY=

# ─── База данных (дефолты: scrapper / postgres / postgres) ──────────────────
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ─── Web Push (браузерные уведомления, VAPID) ───────────────────────────────
# Пара ключей P-256. Сгенерировать (node):
#   node -e "const {generateKeyPairSync}=require('crypto');const {publicKey,privateKey}=generateKeyPairSync('ec',{namedCurve:'prime256v1'});const spki=publicKey.export({type:'spki',format:'der'});console.log(spki.subarray(spki.length-65).toString('base64url'));console.log(privateKey.export({type:'pkcs8',format:'der'}).toString('base64url'))"
# Первая выведенная строка — VAPID_PUBLIC_KEY, вторая — VAPID_PRIVATE_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт для пуш-сервисов (RFC 8292 sub)
VAPID_SUBJECT=mailto:link-tracker@example.com
