# Шаблон окружения для docker compose.

# ─── Telegram-бот ────────────────────────────────────────────────────────────
# Обязателен для бота. Получить у @BotFather (/newbot).
TELEGRAM_TOKEN=

# Общий ключ для внутреннего трафика bot <-> scrapper (заголовок X-Internal-Token).
# Сгенерировать: openssl rand -hex 32
INTERNAL_API_TOKEN=

# Секрет для подписи/валидации JWT (HS256), минимум 32 байта.
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=

# Опциональны (без них API работают на публичных лимитах):
# GitHub: Settings -> Developer settings -> Personal access tokens (classic, без scopes)
GITHUB_TOKEN=
# StackOverflow: stackapps.com -> register app -> key
STACKOVERFLOW_KEY=
STACKOVERFLOW_ACCESS_KEY=

# ─── База данных (дефолты: scrapper / postgres / postgres) ──────────────────
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
