{
  "type": "record",
  "name": "ProcessedUpdateEvent",
  "namespace": "com.example.notification",
  "fields": [
    { "name": "id", "type": "long" },
    { "name": "description", "type": "string" },
    { "name": "tgChatIds", "type": { "type": "array", "items": "long" } },
    { "name": "userIds", "type": { "type": "array", "items": "string" }, "default": [] },
    { "name": "priority", "type": "string" }
  ]
}
