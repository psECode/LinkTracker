    {
      "id": 4,
      "type": "stat",
      "title": "Latency p95 API",
      "description": "95-й процентиль времени ответа основных ручек API (scrapper) за 5m. Цель <1s",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"scrapper\",uri=~\"/api/links|/api/push/.*|/auth/.*\"}[5m])) by (le))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 0.7,
                "result": {
                  "text": "выполняется",
                  "color": "green"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0.7,
                "to": 1,
                "result": {
                  "text": "на грани",
                  "color": "orange"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 999,
                "result": {
                  "text": "не выполняется",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
