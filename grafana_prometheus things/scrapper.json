{
  "title": "Link Tracker · Scrapper",
  "uid": "link-tracker-scrapper",
  "tags": ["scrapper", "api"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "schemaVersion": 39,
  "version": 2,
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Успешность обработки ссылок",
      "description": "Доля успешных проверок ссылок во внешних источниках за 5m. Падение ниже 95% — внешние API недоступны",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "refId": "A", "expr": "100 * (sum(rate(link_checks_total{application=\"scrapper\",outcome=\"success\"}[5m])) or vector(0)) / (sum(rate(link_checks_total{application=\"scrapper\"}[5m])) or vector(1))" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ {"color": "red", "value": null}, {"color": "orange", "value": 93}, {"color": "green", "value": 95} ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "justifyMode": "auto" }
    },
    {
      "id": 2, "type": "stat", "title": "Успешность add/remove ссылок",
      "description": "Доля успешных пользовательских операций со ссылками за 5m",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "refId": "A", "expr": "100 * (sum(rate(links_tracked_total{application=\"scrapper\",outcome=\"success\"}[5m])) or vector(0)) / (sum(rate(links_tracked_total{application=\"scrapper\"}[5m])) or vector(1))" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ {"color": "red", "value": null}, {"color": "orange", "value": 93}, {"color": "green", "value": 95} ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "justifyMode": "auto" }
    },
    {
      "id": 3, "type": "stat", "title": "Latency p95 API",
      "description": "p95 времени ответа основных ручек за 5m",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"scrapper\",uri=~\"/api/links|/api/push/.*|/auth/.*\"}[5m])) by (le))" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [ {"color": "green", "value": null}, {"color": "orange", "value": 0.7}, {"color": "red", "value": 1} ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "id": 4, "type": "stat", "title": "Доступность API",
      "description": "Доля ответов без 5xx за 5m",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "refId": "A", "expr": "100 * (1 - ((sum(rate(http_server_requests_seconds_count{application=\"scrapper\",status=~\"5..\"}[5m])) or vector(0)) / (sum(rate(http_server_requests_seconds_count{application=\"scrapper\"}[5m])) or vector(1))))" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ {"color": "red", "value": null}, {"color": "orange", "value": 93}, {"color": "green", "value": 95} ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "justifyMode": "auto" }
    },
    {
      "id": 5, "type": "timeseries", "title": "Проверки ссылок: успех/неуспех",
      "description": "Темп проверок ссылок во внешних источниках по результату и источнику",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [{ "refId": "A", "expr": "sum(rate(link_checks_total{application=\"scrapper\"}[5m])) by (source, outcome)", "legendFormat": "{{source}} {{outcome}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Время проверки внешних источников p95",
      "description": "p95 request_duration_ms по источнику (github/stackoverflow)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(request_duration_ms_total_seconds_bucket{application=\"scrapper\"}[5m])) by (le, scope_type))", "legendFormat": "{{scope_type}}" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7, "type": "timeseries", "title": "p95 latency по ручкам",
      "description": "p95 http_server_requests по каждой ручке",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"scrapper\"}[5m])) by (le, uri))", "legendFormat": "{{uri}}" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8, "type": "timeseries", "title": "RPS по ручкам",
      "description": "Частота запросов по uri",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [{ "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{application=\"scrapper\"}[1m])) by (uri)", "legendFormat": "{{uri}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 9, "type": "timeseries", "title": "Статусы ответов",
      "description": "Распределение ответов по классам (2xx/4xx/5xx)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "targets": [{ "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{application=\"scrapper\"}[5m])) by (status)", "legendFormat": "{{status}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 10, "type": "timeseries", "title": "Авторизация: успех/неуспех",
      "description": "auth_events_total по операции и результату",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "targets": [{ "refId": "A", "expr": "sum(rate(auth_events_total{application=\"scrapper\"}[5m])) by (operation, outcome)", "legendFormat": "{{operation}} {{outcome}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 11, "type": "stat", "title": "Ссылок на трекинге",
      "description": "links_on_track по типам источников",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 29 },
      "targets": [{ "refId": "A", "expr": "sum(links_on_track{application=\"scrapper\"})" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "id": 12, "type": "stat", "title": "JVM heap к максимуму",
      "description": "Память процесса scrapper",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 29 },
      "targets": [{ "refId": "A", "expr": "max(jvm_memory_used_bytes{application=\"scrapper\", area=\"heap\"} / jvm_memory_max_bytes{application=\"scrapper\", area=\"heap\"})" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [ {"color": "green", "value": null}, {"color": "red", "value": 0.9} ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" }
    },
    {
      "id": 13, "type": "logs", "title": "Логи scrapper",
      "description": "Victoria Logs: WARN/ERROR — сообщение чистым текстом, параметры в args.<имя>",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 29 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "targets": [{ "refId": "A", "expr": "{service.name=\"scrapper\"} AND level:~\"ERROR|WARN\"" }]
    }
  ]
}
