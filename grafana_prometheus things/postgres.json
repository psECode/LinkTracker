{
  "title": "Link Tracker · Postgres",
  "uid": "link-tracker-postgres",
  "tags": ["postgres", "db"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "schemaVersion": 39,
  "version": 1,

  "panels": [
    {
      "id": 1, "type": "stat", "title": "Postgres",
      "description": "pg_up — соединение postgres-exporter с инстансом",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "refId": "A", "expr": "clamp_max(max(pg_up), 1)" }],
      "fieldConfig": { "defaults": { "decimals": 0, "min": 0, "max": 1, "noValue": "unknown", "mappings": [ {"type": "special", "options": {"match": "empty", "result": {"text": "unknown", "color": "gray"}}}, {"type": "value", "options": {"1": {"text": "up", "color": "green"}, "0": {"text": "down", "color": "red"}}} ], "thresholds": { "mode": "absolute", "steps": [ {"color": "red", "value": null}, {"color": "green", "value": 0.5} ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "center" }
    },
    {
      "id": 2, "type": "stat", "title": "Active connections",
      "description": "Суммарное число активных бэкендов по всем базам (pg_stat_database_numbackends)",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "refId": "A", "expr": "sum(pg_stat_database_numbackends)" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ {"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 95} ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "id": 3, "type": "stat", "title": "Cache hit ratio",
      "description": "Доля попаданий в буферный кэш с момента сброса статистики (blks_hit / (blks_hit + blks_read))",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "refId": "A", "expr": "100 * sum(pg_stat_database_blks_hit) / (sum(pg_stat_database_blks_hit) + sum(pg_stat_database_blks_read))" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ {"color": "red", "value": null}, {"color": "orange", "value": 90}, {"color": "green", "value": 97} ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "justifyMode": "auto" }
    },
    {
      "id": 4, "type": "stat", "title": "Transactions/s",
      "description": "Темп коммитов и роллбэков за 5m",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{ "refId": "A", "expr": "sum(rate(pg_stat_database_xact_commit[5m])) + sum(rate(pg_stat_database_xact_rollback[5m]))" }],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2, "noValue": "no data" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "id": 5, "type": "stat", "title": "Deadlocks 5m",
      "description": "Прирост взаимоблокировок за 5m",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [{ "refId": "A", "expr": "sum(increase(pg_stat_database_deadlocks[5m]))" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ {"color": "green", "value": null}, {"color": "red", "value": 1} ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "justifyMode": "auto" }
    },
    {
      "id": 6, "type": "stat", "title": "Exporter scrape",
      "description": "Длительность последнего скрейпа postgres-exporter",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [{ "refId": "A", "expr": "max(pg_exporter_last_scrape_duration_seconds)" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3, "thresholds": { "mode": "absolute", "steps": [ {"color": "green", "value": null}, {"color": "red", "value": 1} ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "id": 7, "type": "timeseries", "title": "Transactions by database",
      "description": "rate коммитов и роллбэков по каждой базе (datname)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(pg_stat_database_xact_commit{datname!=\"\"}[5m])) by (datname)", "legendFormat": "{{datname}} commit" },
        { "refId": "B", "expr": "sum(rate(pg_stat_database_xact_rollback{datname!=\"\"}[5m])) by (datname)", "legendFormat": "{{datname}} rollback" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Connections by state",
      "description": "pg_stat_activity_count по состояниям сессий",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "refId": "A", "expr": "sum(pg_stat_activity_count) by (state)", "legendFormat": "{{state}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 9, "type": "timeseries", "title": "Cache hit ratio over time",
      "description": "Доля попаданий в кэш по базам за 5m",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{ "refId": "A", "expr": "100 * (sum(rate(pg_stat_database_blks_hit{datname!=\"\"}[5m])) by (datname) / (sum(rate(pg_stat_database_blks_hit{datname!=\"\"}[5m])) by (datname) + sum(rate(pg_stat_database_blks_read{datname!=\"\"}[5m])) by (datname)))", "legendFormat": "{{datname}}" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "thresholdsStyle": { "mode": "dashed+lines" } }, "thresholds": { "mode": "absolute", "steps": [ {"color": "red", "value": null}, {"color": "orange", "value": 90}, {"color": "green", "value": 97} ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 10, "type": "timeseries", "title": "Max transaction duration",
      "description": "pg_stat_activity_max_tx_duration по состояниям",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{ "refId": "A", "expr": "max(pg_stat_activity_max_tx_duration) by (state)", "legendFormat": "{{state}}" }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "thresholdsStyle": { "mode": "dashed+lines" } }, "thresholds": { "mode": "absolute", "steps": [ {"color": "green", "value": null}, {"color": "red", "value": 300} ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 11, "type": "timeseries", "title": "Deadlocks & temp files",
      "description": "Темп взаимоблокировок и использование временных файлов по базам",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(pg_stat_database_deadlocks{datname!=\"\"}[5m])) by (datname)", "legendFormat": "{{datname}} deadlocks/s" },
        { "refId": "B", "expr": "sum(rate(pg_stat_database_temp_files{datname!=\"\"}[5m])) by (datname)", "legendFormat": "{{datname}} temp files/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 12, "type": "timeseries", "title": "Background writer buffers",
      "description": "Скорость выделения и записи буферов (pg_stat_bgwriter)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(pg_stat_bgwriter_buffers_alloc[5m]))", "legendFormat": "alloc/s" },
        { "refId": "B", "expr": "sum(rate(pg_stat_bgwriter_buffers_checkpoint[5m]))", "legendFormat": "checkpoint/s" },
        { "refId": "C", "expr": "sum(rate(pg_stat_bgwriter_buffers_backend[5m]))", "legendFormat": "backend/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } }
    }
  ]
}
